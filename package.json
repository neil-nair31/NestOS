{
  "name": "nestos",
  "version": "0.1.0",
  "private": true,
  "description": "NestOS — live ops platform for HummingBrains",
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",

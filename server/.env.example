PORT=4100
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4100

# sqlite (default) | local (JSON fallback with FORCE_JSON=1) | supabase
STORE_MODE=sqlite
# On Railway/Render/Docker mount: DATA_DIR=/data
DATA_DIR=
JWT_SECRET=nestos-dev-secret-change-me
JWT_DAYS=7
# Set 1 on HTTPS hosts so login cookies work
COOKIE_SECURE=0
NODE_ENV=development

# Supabase (optional when STORE_MODE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes

# Azure Document Intelligence (optional — model service falls back to unpdf)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Resend email (optional — logs to console when unset)
RESEND_API_KEY=
RESEND_FROM=NestOS <onboarding@resend.dev>
NOTIFY_EMAIL=

# WhatsApp Business number (digits only)
WHATSAPP_BUSINESS_NUMBER=919886444476
